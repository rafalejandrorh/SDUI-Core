{
    "name": "sdui/core",
    "description": "PHP builders that emit SDUI JSON (docs.sdui.dev).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sdui\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sdui\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-html=coverage"
    }
}

{
    "name": "stac/stac-php",
    "description": "PHP builders that emit Stac SDUI JSON (docs.stac.dev).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Stac\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stac\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
